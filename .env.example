# Required for production builds (validated in next.config.ts).
# Vercel Preview skips the build check; Production still requires both.
# For local dev without real values, use: SKIP_CONTACT_ENV_CHECK=1
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=+14065551234

# Optional: skip contact env validation (do not use in production deploys)
# SKIP_CONTACT_ENV_CHECK=1
