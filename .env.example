# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public contact info (required for production build; validated in next.config.ts)
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=+14065551234

# Automation / integrations (optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/your-workflow-id
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# Optional: skip contact env validation (do not use in production deploys)
# SKIP_CONTACT_ENV_CHECK=1
